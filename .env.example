# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / Neon / Supabase / Railway / Docker)
# If left blank or unreachable, the system automatically uses the local SQLite engine fallback
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/football_analytics
SQLITE_DB_PATH=./data/football_analytics.db

# Football Data Provider Configuration
# Options: 'auto' | 'api-football' | 'football-data' | 'verified-archive' | 'openfootball'
# 'auto': Tries live API first if key provided; seamlessly falls back to verified archive if unavailable or rate limited
DATA_PROVIDER=auto

# API Keys (Get free key at https://www.api-football.com/ or https://rapidapi.com/api-sports/api/api-football)
API_FOOTBALL_KEY=
# Alternative: https://www.football-data.org/
FOOTBALL_DATA_ORG_KEY=

# API-Football free-tier budget (optional)
API_FOOTBALL_DAILY_LIMIT=90
API_FOOTBALL_SAFETY_MARGIN=10

# OpenFootball supplementary historical data (optional)
OPENFOOTBALL_ENABLED=true
OPENFOOTBALL_DATA_DIR=./data/openfootball

# In-Memory / File Cache TTL (minutes) to protect external API rate limits
CACHE_TTL_MINUTES=15

# Scheduled Background Sync (Cron format)
SYNC_CRON_SCHEDULE=0 */4 * * *

# Discord (optional)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_WEBHOOK_URL=
ENABLE_DISCORD_HOURLY=true
DISCORD_UPDATE_INTERVAL=1h

# Daily parlay report
REPORT_TIMEZONE=Africa/Harare
PARLAY_REPORT_CHANNEL_ID=

# Public URL (production)
PUBLIC_URL=http://localhost:5000
